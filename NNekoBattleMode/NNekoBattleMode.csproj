<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <Name>NNekoBattleMode</Name>
        <Author>NaughtyNeko</Author>
        <Punchline>Intelligent management of draw/sheathe actions for a popular game.</Punchline>
        <Description>Intelligent management of draw/sheathe actions for a popular game.</Description>
        <PackageProjectUrl>https://github.com/NNekoPlugins/NNekoBattleMode</PackageProjectUrl>
        <Tags>NNeko,NaughtyNeko,Triggers,RP,Conditional,Commands,Utility,Other</Tags>
        <WarningLevel>4</WarningLevel>
        <PackageLicenseExpression>APGL-3.0-or-later</PackageLicenseExpression>
        <Deterministic>true</Deterministic>
        <CopyLocalLockfileAssemblies>true</CopyLocalLockfileAssemblies>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <ImplicitUsings>enable</ImplicitUsings>
        <NoWarn>$(NoWarn);IDE1006,CS8618,MSB3270</NoWarn>
        <!-- Version stamping (GitVersion supplied by CI workflow) -->
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

        <!-- Fallback version if GitVersion is not provided -->
        <Version>0.0.0</Version>

        <!-- These will be set by /p:GitVersion=1.2.3 in your workflow -->
        <AssemblyVersion>$(GitVersion)</AssemblyVersion>
        <FileVersion>$(GitVersion)</FileVersion>
        <InformationalVersion>$(GitVersion)</InformationalVersion>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Data\NNeko.png" />
        <Content Include="NNekoBattleMode.json" />
        <None Update="NNekoBattleMode.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <EmbeddedResource Include="Data\NNeko.png" />
        <PackageReference Include="ECommons" Version="3.2.0.17" />
        <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.2" />
    </ItemGroup>
</Project>